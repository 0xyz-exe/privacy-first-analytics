# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Secrets
JWT_SECRET=replace-with-a-random-32-character-secret-key
PRIVACY_SALT=replace-with-a-secure-rotating-salt-for-visitor-hashing

# Database (Default: Built-in high-performance SQLite in ./data/analytics.db)
DATA_DIR=./data
DATABASE_PATH=./data/analytics.db

# Optional PostgreSQL Connection (if using external PostgreSQL instance)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/privacy_analytics
